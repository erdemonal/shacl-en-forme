#
# SHACL shapes for the SHACL en Forme.
#
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix sef:  <https://w3id.org/shacl-en-forme/vocab#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

sef:AnalysisResultsShape
    a sh:NodeShape ;
    sh:targetClass sef:AnalysisResults ;
    sh:property [
        sh:path sef:extracted_unique_trees ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:has_coverage ;
        sh:class sef:DatasetCoverage ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:has_consistency ;
        sh:class sef:ConsistencyAnalysis ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:has_document_characteristics ;
        sh:class sef:DocumentCharacteristicsAnalysis ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:has_functional_usage ;
        sh:class sef:FunctionalUsageAnalysis ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:has_purpose_classification ;
        sh:class sef:PurposeClassificationAnalysis ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:has_domain_classification ;
        sh:class sef:DomainClassificationAnalysis ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

sef:ClassificationResultShape
    a sh:NodeShape ;
    sh:targetClass sef:ClassificationResult ;
    sh:property [
        sh:path sef:category ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:counting_unit ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:n_with_label ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:denominator ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:rate ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

sef:ConsistencyAnalysisShape
    a sh:NodeShape ;
    sh:targetClass sef:ConsistencyAnalysis ;
    sh:property [
        sh:path sef:confirmed_consistency_findings ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:trees_with_consistency_findings ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:contents_with_consistency_findings ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:denominator_extracted_trees ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

sef:AlignmentAnalysisShape
    a sh:NodeShape ;
    sh:targetClass sef:AlignmentAnalysis ;
    sh:property [
        sh:path sef:denominator_extracted_trees ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:both_stream_trees ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:trees_with_matching_ontology_terms ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:trees_without_matching_ontology_terms ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

sef:VocabularyUsageAnalysisShape
    a sh:NodeShape ;
    sh:targetClass sef:VocabularyUsageAnalysis ;
    sh:property [
        sh:path sef:trees_with_shape_documents ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

sef:OwlShaclConstraintAnalysisShape
    a sh:NodeShape ;
    sh:targetClass sef:OwlShaclConstraintAnalysis ;
    sh:property [
        sh:path sef:trees_with_property_range_comparisons ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:identical_range_tree_property_pairs ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:trees_with_owl_value_restriction_comparisons ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:identical_all_values_from_comparisons ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:identical_some_values_from_comparisons ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:trees_with_cardinality_comparisons ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:identical_min_cardinality_tree_property_pairs ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:identical_max_cardinality_tree_property_pairs ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

sef:DocumentCharacteristicsAnalysisShape
    a sh:NodeShape ;
    sh:targetClass sef:DocumentCharacteristicsAnalysis ;
    sh:property [
        sh:path sef:test_or_example_path_documents ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:generation_related_path_documents ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sef:ontology_or_profile_indicator_documents ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .
