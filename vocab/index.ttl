@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix :     <https://w3id.org/shacl-en-forme/vocab#> .

<https://w3id.org/shacl-en-forme/vocab>
    a owl:Ontology ;
    dct:title "SHACL en Forme vocabulary"@en ;
    dct:description "Terms used in the SHACL en Forme machine-readable usage statistics."@en ;
    dct:creator <https://w3id.org/people/erdemonal> ;
    dct:created "2026"^^xsd:gYear ;
    vann:preferredNamespaceUri "https://w3id.org/shacl-en-forme/vocab#" ;
    vann:preferredNamespacePrefix "sef" ;
    rdfs:seeAlso <https://w3id.org/shacl-en-forme/> ,
                 <https://w3id.org/shacl-en-forme/data/stats.jsonld> ,
                 <https://www.w3.org/TR/2017/REC-shacl-20170720/> .

#################################################################
# Classes
#################################################################

:AnalysisResults
    a rdfs:Class ;
    rdfs:label "Analysis results"@en ;
    rdfs:comment "A dataset of measured SHACL 1.0 usage statistics over a corpus of Git trees."@en .

#################################################################
# Corpus size
#################################################################

:intended_unique_verified_trees
    a rdf:Property ;
    rdfs:label "intended unique verified trees"@en ;
    rdfs:comment "Number of distinct verified Git trees in the intended corpus."@en ;
    rdfs:range xsd:integer .

:extracted_unique_trees
    a rdf:Property ;
    rdfs:label "extracted unique trees"@en ;
    rdfs:comment "Number of distinct Git trees successfully extracted for analysis."@en ;
    rdfs:range xsd:integer .

:lower_bound
    a rdf:Property ;
    rdfs:label "lower bound"@en ;
    rdfs:comment "True when reported counts are conservative lower bounds due to incomplete extraction or parsing."@en ;
    rdfs:range xsd:boolean .

#################################################################
# Counting primitives
#################################################################

:predicate
    a rdf:Property ;
    rdfs:label "predicate"@en ;
    rdfs:comment "The SHACL predicate or IRI whose usage is counted."@en ;
    rdfs:range rdfs:Resource .

:occurrences
    a rdf:Property ;
    rdfs:label "occurrences"@en ;
    rdfs:comment "Number of observed occurrences of a counted phenomenon in extracted trees."@en ;
    rdfs:range xsd:integer .

:unique_trees
    a rdf:Property ;
    rdfs:label "unique trees"@en ;
    rdfs:comment "Number of distinct extracted Git trees in which a phenomenon was observed."@en ;
    rdfs:range xsd:integer .

:percent_of_extracted_trees
    a rdf:Property ;
    rdfs:label "percent of extracted trees"@en ;
    rdfs:comment "unique_trees as a percentage of extracted_unique_trees."@en ;
    rdfs:range xsd:decimal .

:verified_repositories
    a rdf:Property ;
    rdfs:label "verified repositories"@en ;
    rdfs:comment "Number of verified GitHub repositories associated with trees that exhibited a phenomenon."@en ;
    rdfs:range xsd:integer .

:percent_of_verified_repositories
    a rdf:Property ;
    rdfs:label "percent of verified repositories"@en ;
    rdfs:comment "verified_repositories as a percentage of all verified repositories in the corpus."@en ;
    rdfs:range xsd:decimal .

:denominator_extracted_trees
    a rdf:Property ;
    rdfs:label "denominator extracted trees"@en ;
    rdfs:comment "Tree population used as denominator for tree-based rates."@en ;
    rdfs:range xsd:integer .

:denominator_verified_repositories
    a rdf:Property ;
    rdfs:label "denominator verified repositories"@en ;
    rdfs:comment "Repository population used as denominator for repository-based rates."@en ;
    rdfs:range xsd:integer .

:total_occurrences
    a rdf:Property ;
    rdfs:label "total occurrences"@en ;
    rdfs:comment "Sum of occurrences across a result group."@en ;
    rdfs:range xsd:integer .

:numerator
    a rdf:Property ;
    rdfs:label "numerator"@en ;
    rdfs:comment "Numerator of a rate."@en ;
    rdfs:range xsd:integer .

:denominator
    a rdf:Property ;
    rdfs:label "denominator"@en ;
    rdfs:comment "Denominator of a rate."@en ;
    rdfs:range xsd:integer .

:micro_rate
    a rdf:Property ;
    rdfs:label "micro rate"@en ;
    rdfs:comment "Micro-averaged rate equal to numerator divided by denominator."@en ;
    rdfs:range xsd:decimal .

:rate
    a rdf:Property ;
    rdfs:label "rate"@en ;
    rdfs:comment "Proportion of labelled items within a stated population."@en ;
    rdfs:range xsd:decimal .

:n_with_label
    a rdf:Property ;
    rdfs:label "n with label"@en ;
    rdfs:comment "Number of items carrying a given classification label."@en ;
    rdfs:range xsd:integer .

#################################################################
# Shapes
#################################################################

:node_shapes
    a rdf:Property ;
    rdfs:label "node shapes"@en ;
    rdfs:comment "Count of resources typed as sh:NodeShape."@en ;
    rdfs:range xsd:integer .

:property_shapes
    a rdf:Property ;
    rdfs:label "property shapes"@en ;
    rdfs:comment "Count of resources typed as sh:PropertyShape."@en ;
    rdfs:range xsd:integer .

:distinct_shapes
    a rdf:Property ;
    rdfs:label "distinct shapes"@en ;
    rdfs:comment "Count of distinct resources typed as sh:NodeShape and/or sh:PropertyShape."@en ;
    rdfs:range xsd:integer .

:shape_documents
    a rdf:Property ;
    rdfs:label "shape documents"@en ;
    rdfs:comment "Number of RDF documents that contain SHACL shapes."@en ;
    rdfs:range xsd:integer .

:trees_with_shape_documents
    a rdf:Property ;
    rdfs:label "trees with shape documents"@en ;
    rdfs:comment "Number of extracted Git trees that contain at least one shape document."@en ;
    rdfs:range xsd:integer .

:content_sha256_groups
    a rdf:Property ;
    rdfs:label "content SHA-256 groups"@en ;
    rdfs:comment "Number of distinct document contents after SHA-256 deduplication."@en ;
    rdfs:range xsd:integer .

#################################################################
# SPARQL
#################################################################

:trees_with_structural_constraints
    a rdf:Property ;
    rdfs:label "trees with structural constraints"@en ;
    rdfs:comment "Number of extracted Git trees containing SHACL-SPARQL structural constraint usage."@en ;
    rdfs:range xsd:integer .

:sparql_links
    a rdf:Property ;
    rdfs:label "SPARQL links"@en ;
    rdfs:comment "Number of sh:sparql links observed in extracted trees."@en ;
    rdfs:range xsd:integer .

:sparql_constraint_nodes
    a rdf:Property ;
    rdfs:label "SPARQL constraint nodes"@en ;
    rdfs:comment "Number of SPARQL constraint nodes observed in extracted trees."@en ;
    rdfs:range xsd:integer .

:sparql_target_trees
    a rdf:Property ;
    rdfs:label "SPARQL target trees"@en ;
    rdfs:comment "Number of extracted Git trees with SPARQL-based targets."@en ;
    rdfs:range xsd:integer .

#################################################################
# Property paths
#################################################################

:nested_forms_counted_separately
    a rdf:Property ;
    rdfs:label "nested forms counted separately"@en ;
    rdfs:comment "True when nested SHACL property-path forms contribute separate occurrence counts, so form occurrence totals may exceed path declaration totals."@en ;
    rdfs:range xsd:boolean .

:form
    a rdf:Property ;
    rdfs:label "path form"@en ;
    rdfs:comment "Name of a SHACL 1.0 property-path form, such as PredicatePath or SequencePath."@en ;
    rdfs:range xsd:string .

:path_declarations
    a rdf:Property ;
    rdfs:label "path declarations"@en ;
    rdfs:comment "Number of sh:path declarations observed in extracted trees."@en ;
    rdfs:range xsd:integer .

:classified
    a rdf:Property ;
    rdfs:label "classified"@en ;
    rdfs:comment "Number of path declarations classified into one of the seven SHACL 1.0 property-path forms."@en ;
    rdfs:range xsd:integer .

:unclassified
    a rdf:Property ;
    rdfs:label "unclassified"@en ;
    rdfs:comment "Number of path declarations not classified into a SHACL 1.0 property-path form."@en ;
    rdfs:range xsd:integer .

#################################################################
# Ontology alignment
#################################################################

:both_stream_trees
    a rdf:Property ;
    rdfs:label "both-stream trees"@en ;
    rdfs:comment "Number of extracted Git trees that contribute both shapes-stream and ontology-stream evidence used by alignment rates."@en ;
    rdfs:range xsd:integer .

#################################################################
# Constraint consistency
#################################################################

:shapes_graph_policy
    a rdf:Property ;
    rdfs:label "shapes graph policy"@en ;
    rdfs:comment "Policy describing which RDF graphs were treated as shapes graphs for consistency analysis."@en ;
    rdfs:range xsd:string .

:primary_records
    a rdf:Property ;
    rdfs:label "primary records"@en ;
    rdfs:comment "Number of primary constraint-consistency records."@en ;
    rdfs:range xsd:integer .

:primary_logic05_confirmed
    a rdf:Property ;
    rdfs:label "primary Logic05 confirmed"@en ;
    rdfs:comment "Number of primary records confirmed under the Logic05 criterion."@en ;
    rdfs:range xsd:integer .

:primary_closed02_confirmed
    a rdf:Property ;
    rdfs:label "primary Closed02 confirmed"@en ;
    rdfs:comment "Number of primary records confirmed under the Closed02 criterion."@en ;
    rdfs:range xsd:integer .

#################################################################
# Classification
#################################################################

:multi_label
    a rdf:Property ;
    rdfs:label "multi-label"@en ;
    rdfs:comment "True when classification labels may overlap on the same item."@en ;
    rdfs:range xsd:boolean .
