PREFIX sef: <https://w3id.org/shacl-en-forme/vocab#>

SELECT ?path_form ?occurrences ?unique_trees ?percent_of_extracted_trees
WHERE {
  ?dataset a sef:AnalysisResults ;
           sef:has_property_path_analysis ?analysis .
  ?analysis sef:feature_frequency ?record .
  ?record a sef:FeatureFrequency ;
          sef:path_form ?path_form ;
          sef:occurrences ?occurrences ;
          sef:unique_trees ?unique_trees ;
          sef:percent_of_extracted_trees ?percent_of_extracted_trees .
}
ORDER BY DESC(?occurrences)
